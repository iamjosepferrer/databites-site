{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/write",
      "destination": "/write.html"
    },
    {
      "source": "/work-with-me",
      "destination": "/work-with-me.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/learn",
      "destination": "/work-with-me#sponsorship",
      "permanent": false
    },
    {
      "source": "/teach",
      "destination": "/work-with-me#training",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/work-with-me?utm_source=x&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/in",
      "destination": "/work-with-me?utm_source=linkedin&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/nl",
      "destination": "/work-with-me?utm_source=newsletter&utm_medium=link",
      "permanent": false
    },
    {
      "source": "/gh",
      "destination": "/work-with-me?utm_source=github&utm_medium=readme",
      "permanent": false
    }
  ]
}
