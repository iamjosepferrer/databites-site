{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/substack-feed",
      "destination": "https://reads.databites.tech/feed"
    },
    {
      "source": "/write",
      "destination": "/write.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
